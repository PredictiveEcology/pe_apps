# ADD this block to /srv/wbi/Caddyfile, next to the existing wbi.predictiveecology.org block.
# Do not replace the existing block. Caddy gets the certificate for this host automatically.
apps.predictiveecology.org {
    root * /apps-site

    # Same path handling as wbi_shiny's /apps/*: handle_path strips the prefix,
    # so the Shiny app sees "/" and its relative URLs work under /firesense/elfmaps/.
    redir /firesense/elfmaps /firesense/elfmaps/ permanent
    # The map's rasters are read by the browser with HTTP range requests, same origin, from the bucket.
    # This handler must come before the app handler below.
    handle_path /firesense/elfmaps/data/* {
        rewrite * /529feda02d404836b0e91b1d360b4df0:predictiveecology/firesense/elfmaps{uri}
        reverse_proxy https://object-arbutus.alliancecan.ca {
            header_up Host object-arbutus.alliancecan.ca
        }
    }
    handle_path /firesense/elfmaps/* {
        reverse_proxy firesense-elfmaps:8080
    }

    # The fit ledger app was replaced by the ELF maps app.
    redir /firesense/fitledger /firesense/elfmaps/ permanent
    redir /firesense/fitledger/* /firesense/elfmaps/ permanent

    file_server
    log {
        output file /var/log/caddy/apps-access.log
    }
}
